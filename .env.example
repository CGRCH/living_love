# Living Love — variables de entorno (copiar a .env)

# Django
SECRET_KEY=cambia-esto-en-produccion-usa-32-caracteres-minimo
DEBUG=1
DATABASE_URL=postgres://livinglove:livinglove@db:5432/livinglove
# Local sin Docker: sqlite:///backend/db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PAYMENT_WEBHOOK_SECRET=
# Solo CI/demos locales — nunca en producción
PAYMENTS_ALLOW_SIMULATED_CONFIRM=1
# Contraseña del admin creado por seed_livinglove (rotar tras primer login)
ADMIN_INITIAL_PASSWORD=

# Email (MailHog en Docker)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=tienda@livinglove.cl

# Opcional: secreto HMAC por pasarela (sobreescribe PAYMENT_WEBHOOK_SECRET)
# PAYMENT_WEBHOOK_SECRET_WEBPAY=
# PAYMENT_WEBHOOK_SECRET_MERCADOPAGO=

# Cifrado credenciales pasarelas (32+ chars recomendado)
PAYMENTS_ENCRYPTION_KEY=

# SumUp (sandbox/live)
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
